<Window x:Class="UMM.提示窗口"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UMM"
        mc:Ignorable="d"
        Title="提示" Height="140" Width="320" MinHeight="140" MinWidth="320" MaxHeight="300" MaxWidth="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="提示信息" FontSize="16" Margin="20,10,20,5" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Grid.Row="1" x:Name="确定按钮" Content="确定" FontSize="16" Margin="10,5,10,10" Width="60" Height="auto" HorizontalAlignment="Center" Click="确定按钮_Click"/>
    </Grid>
</Window>
