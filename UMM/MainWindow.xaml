<Window
    x:Class="UMM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:UMM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="UE通用Mod管理器"
    Width="800"
    Height="450"
    MinWidth="1200"
    MinHeight="800"
    Icon="/图标/UMM.ico"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid Margin="4,4,4,2" Background="#FFF1F1F1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="启动游戏"
                    Grid.Column="0"
                    Width="120"
                    Height="auto"
                    Margin="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="启动游戏"
                    FontSize="24" />
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="4,4,4,2"
                        VerticalAlignment="Stretch"
                        FontSize="16"
                        Text="游戏路径:" />
                    <TextBlock
                        x:Name="游戏路径"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,4,4,2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        FontSize="16" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="4,2,4,4"
                        VerticalAlignment="Stretch"
                        FontSize="16"
                        Text="模组路径:" />
                    <TextBlock
                        x:Name="模组路径"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="4,2,4,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        FontSize="16" />
                </Grid>

            </Grid>
        </Grid>
        <Grid Grid.Row="1">
            <Grid Margin="4,2,4,2" Background="#FFF1F1F1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="搜索输入"
                    Grid.Column="0"
                    Width="300"
                    Margin="4,4,2,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    FontSize="16" />
                <Button
                    x:Name="搜索按钮"
                    Grid.Column="1"
                    Width="40"
                    Margin="2,4,2,4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Content="搜索"
                    FontSize="16" />
                <TextBlock
                    Grid.Column="3"
                    Margin="2,4,2,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="已启用模组:" />
                <TextBlock
                    x:Name="已启用模组"
                    Grid.Column="4"
                    Margin="2,4,4,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16" />
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid Margin="4,2,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#FFBBBBBB">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="4,4,2,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="游戏列表" />
                        <Button
                            x:Name="添加游戏"
                            Grid.Column="1"
                            Width="25"
                            Margin="2,4,4,4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="+"
                            FontSize="16" />
                    </Grid>
                    <ListBox
                        x:Name="游戏列表"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#FFF1F1F1"
                        BorderThickness="0"
                        FontSize="16"
                        MouseRightButtonUp="游戏列表_MouseRightButtonUp" />
                </Grid>
            </Grid>
            <Grid Grid.Column="1">
                <Grid Margin="2,2,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#FFBBBBBB">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="4,4,2,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="模组分类" />
                        <Button
                            x:Name="添加模组分类"
                            Grid.Column="1"
                            Width="25"
                            Margin="2,4,4,4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="+"
                            FontSize="16" />
                    </Grid>
                    <ListBox
                        x:Name="模组分类"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#FFF1F1F1"
                        BorderThickness="0"
                        FontSize="16"
                        MouseRightButtonUp="模组分类_MouseRightButtonUp" />
                </Grid>
            </Grid>
            <Grid Grid.Column="2">
                <Grid Margin="2,2,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#FFBBBBBB">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="4,4,2,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="模组列表" />
                        <Button
                            x:Name="添加模组"
                            Grid.Column="1"
                            Width="25"
                            Margin="2,4,4,4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="+"
                            FontSize="16" />
                    </Grid>
                    <ListBox
                        x:Name="模组列表"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#FFF1F1F1"
                        BorderThickness="0"
                        FontSize="16"
                        ItemsSource="{Binding 模组列表数据Ex, RelativeSource={RelativeSource AncestorType=Window}}"
                        MouseRightButtonUp="模组列表_MouseRightButtonUp"
                        SelectedItem="{Binding SelectedModItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay}">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
            <Grid Grid.Column="3">
                <Grid Margin="2,2,4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#FFBBBBBB">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="4,4,2,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="模组详情" />
                        <Button
                            x:Name="添加图片"
                            Grid.Column="1"
                            Width="25"
                            Margin="2,4,4,4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="+"
                            FontSize="16" />
                    </Grid>
                    <Grid Grid.Row="1" Background="#FFF7F7F7">
                        <Viewbox Stretch="Uniform">
                            <Border
                                Width="320"
                                Height="180"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Grid>
                                    <Image x:Name="图片显示" Stretch="Uniform" />
                                    <TextBlock
                                        x:Name="无图片提示"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="40"
                                        Foreground="#FFB4B4B4"
                                        IsHitTestVisible="False"
                                        Text="无图片"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Viewbox>
                    </Grid>
                    <Grid Grid.Row="2" Background="#FFF1F1F1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="4,4,4,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="图片名称:" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="4,2,4,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="模组名称:" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="4,2,4,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="模组原始名称:" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="4,2,4,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="是否已启用:" />
                        <TextBlock
                            x:Name="模组详情图片名称"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="4,4,4,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16" />
                        <TextBlock
                            x:Name="模组详情模组名称"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4,2,4,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16" />
                        <TextBlock
                            x:Name="模组详情模组原始名称"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="4,2,4,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16" />
                        <TextBlock
                            x:Name="模组详情是否已启用"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="4,2,4,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid
            Grid.Row="3"
            Margin="4,2,4,4"
            Background="#FFF1F1F1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Margin="4"
                VerticalAlignment="Center"
                FontSize="16"
                Text="备份路径:" />
            <Border
                Grid.Column="1"
                Margin="2,4,2,4"
                BorderBrush="#FF707070"
                BorderThickness="1">
                <TextBlock
                    x:Name="备份路径"
                    Width="600"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="16" />
            </Border>
            <Button
                x:Name="添加备份路径"
                Grid.Column="2"
                Width="25"
                Margin="4"
                Content="···"
                FontSize="16" />
            <TextBlock
                Grid.Column="4"
                Margin="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="16"
                Text="V0.2" />
        </Grid>
    </Grid>
</Window>
