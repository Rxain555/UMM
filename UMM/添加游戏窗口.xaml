<Window x:Class="UMM.添加游戏窗口"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UMM"
        mc:Ignorable="d"
        Title="添加游戏" Height="170" Width="700" MinHeight="170" MinWidth="700" MaxHeight="170" MaxWidth="700"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏名称:" FontSize="16" VerticalAlignment="Center" Margin="4,4,2,2"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏路径:" FontSize="16" VerticalAlignment="Center" Margin="4,2,2,2"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="模组路径:" FontSize="16" VerticalAlignment="Center" Margin="4,2,2,4"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="游戏名称" Margin="2,4,2,2" FontSize="16" Height="25" VerticalAlignment="Stretch"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="游戏路径" Margin="2,2,2,2" FontSize="16" VerticalAlignment="Stretch"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="模组路径" Margin="2,2,2,2" FontSize="16" VerticalAlignment="Stretch"/>
            <Button Grid.Row="1" Grid.Column="2" x:Name="选择游戏路径" Content="···" Margin="2,2,4,2" FontSize="16" Width="25" VerticalAlignment="Stretch" Click="选择游戏路径_Click"/>
            <Button Grid.Row="2" Grid.Column="2" x:Name="选择模组路径" Content="···" Margin="2,2,4,2" FontSize="16" Width="25" VerticalAlignment="Stretch" Click="选择模组路径_Click"/>
        </Grid>
        <Button Grid.Row="1" x:Name="确认" Content="确认" FontSize="16" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center" Click="确认_Click" />
    </Grid>
</Window>
