<Window x:Class="UMM.选择窗口"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择导入类型" Height="140" Width="220"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" x:Name="选择压缩包" Content="选择压缩包" FontSize="16" Width="120" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10,10,10,5" Click="选择压缩包_Click"/>
        <Button Grid.Row="1" x:Name="选择文件夹" Content="选择文件夹" FontSize="16" Width="120" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,5,10,10" Click="选择文件夹_Click"/>
    </Grid>
</Window>
